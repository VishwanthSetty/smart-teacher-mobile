<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only: permits cleartext to the local API and object
         store, which HLS segment redirects need in `api` storage mode. See
         res/xml/network_security_config.xml. Release builds inherit the
         platform default, where cleartext is blocked outright. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
